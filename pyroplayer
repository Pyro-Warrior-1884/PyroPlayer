# ============================================================
# CLI
# ============================================================

def main():

    if len(sys.argv) >= 2:

        if sys.argv[1] == "--daemon":
            run_daemon()
            return

    command = sys.argv[1] if len(sys.argv) > 1 else ""

    # --------------------------------------------------------
    # Start
    # --------------------------------------------------------

    if command == "start":

        start_daemon()

        result = send_command("status")

        if result["active"]:
            print(
                "🔥 PyroPlayer is already running."
            )
            print(
                f"🎵 {result['song']}"
            )
            return

        print()
        print("🔥 PYROPLAYER")
        print("────────────────────────────────")
        print()
        print("How should the first song be chosen?")
        print()
        print("  1) Choose a song")
        print("  2) Random song")
        print()

        choice = input(
            "Choice [1/2]: "
        ).strip()

        if choice == "1":

            # Get available songs directly.
            songs = send_command("available")

            if not songs:
                print(
                    "No unplayed songs available."
                )
                return

            result = subprocess.run(
                [
                    "fzf",
                    "--height=80%",
                    "--layout=reverse",
                    "--border",
                    "--prompt=🎵 Select first song: "
                ],
                input=songs,
                text=True,
                capture_output=True
            )

            if result.returncode != 0:
                return

            song = result.stdout.strip()

            if song:
                print(
                    send_command(
                        "play",
                        song
                    )
                )

        elif choice == "2":

            print(
                send_command(
                    "start_random"
                )
            )

        else:

            print("Invalid choice.")

        return

    # --------------------------------------------------------
    # Commands that don't require daemon
    # --------------------------------------------------------

    if command in ("", "help", "--help", "-h"):

        help_text()
        return

    # --------------------------------------------------------
    # Ensure daemon exists
    # --------------------------------------------------------

    start_daemon()

    # --------------------------------------------------------
    # Current
    # --------------------------------------------------------

    if command == "c":

        result = send_command("status")

        print()
        print(
            f"🎵 {result['song'] or 'Nothing playing'}"
        )
        print(
            f"State: {result['state']}"
        )
        print(
            f"Played: {result['played']} / "
            f"{result['total']}"
        )

        return

    # --------------------------------------------------------
    # History
    # --------------------------------------------------------

    if command == "h":

        songs = send_command("history")

        if not songs:
            print("No songs have been played yet.")
            return

        result = subprocess.run(
            [
                "fzf",
                "--height=80%",
                "--layout=reverse",
                "--border",
                "--prompt=🔥 History: "
            ],
            input=songs,
            text=True,
            capture_output=True
        )

        if result.returncode != 0:
            return

        selected = result.stdout.strip()

        if not selected:
            return

        # Remove the history number from the selected line.
        #
        # Example:
        # "  7  Holiday.mp3"
        #
        # becomes:
        # "Holiday.mp3"

        parts = selected.split(maxsplit=1)

        if len(parts) != 2:
            print("ERROR: Invalid history entry.")
            return

        song = parts[1]

        print(
            send_command(
                "history_play",
                song
            )
        )

        return

    # --------------------------------------------------------
    # Queue
    # --------------------------------------------------------

    if command == "queue":

        print()
        print("🔥 PYROPLAYER QUEUE")
        print("────────────────────────────────")

        print(
            send_command("queue")
        )

        return

    # --------------------------------------------------------
    # Select and play now
    # --------------------------------------------------------

    if command == "s":

        songs = send_command("available")

        if not songs:
            print(
                "No unplayed songs available."
            )
            return

        result = subprocess.run(
            [
                "fzf",
                "--height=80%",
                "--layout=reverse",
                "--border",
                "--prompt=🎵 Play now: "
            ],
            input=songs,
            text=True,
            capture_output=True
        )

        if result.returncode != 0:
            return

        song = result.stdout.strip()

        if song:
            print(
                send_command(
                    "play",
                    song
                )
            )

        return

    # --------------------------------------------------------
    # Choose next
    # --------------------------------------------------------

    if command == "next":

        songs = send_command("available")

        if not songs:
            print(
                "No unplayed songs available."
            )
            return

        result = subprocess.run(
            [
                "fzf",
                "--height=80%",
                "--layout=reverse",
                "--border",
                "--prompt=⏭ Choose next: "
            ],
            input=songs,
            text=True,
            capture_output=True
        )

        if result.returncode != 0:
            return

        song = result.stdout.strip()

        if song:
            print(
                send_command(
                    "queue_add",
                    song
                )
            )

        return

    # --------------------------------------------------------
    # Random next
    # --------------------------------------------------------

    if command == "n":

        print(
            send_command(
                "next_random"
            )
        )

        return

    # --------------------------------------------------------
    # Previous
    # --------------------------------------------------------

    if command == "p":

        print(
            send_command(
                "previous"
            )
        )

        return

    # --------------------------------------------------------
    # Pause
    # --------------------------------------------------------

    if command == "pause":

        send_command("pause")
        return

    # --------------------------------------------------------
    # Restart
    # --------------------------------------------------------

    if command == "r":

        send_command("restart")
        return

    # --------------------------------------------------------
    # Stop
    # --------------------------------------------------------

    if command == "q":

        print(
            send_command("stop")
        )

        return

    # --------------------------------------------------------
    # Reset
    # --------------------------------------------------------

    if command == "reset":

        send_command("reset")

        print(
            "🔥 Playback cycle reset."
        )

        return

    print(
        f"Unknown command: {command}"
    )

    print(
        "Run 'pyroplayer' for help."
    )


if __name__ == "__main__":
    main()
